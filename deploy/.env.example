# deploy/.env: settings for deploy/compose.yml. Copy to deploy/.env, fill in, never commit it.
# Every value below is a placeholder.

# REQUIRED. The public host name (DNS must point here for real HTTPS). "localhost" runs the whole
# stack locally with Caddy's own certificate authority.
TWIN_PUBLIC_HOST=twin.example.org

# REQUIRED. Database credentials. Use a long random password made of letters and digits only
# (it is placed inside a URL), e.g.:  openssl rand -hex 32
POSTGRES_USER=twin
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_DB=twin

# Optional. Where the processed CGMacros artifacts and model bundles are on this host (relative to
# deploy/). Made by deploy/package-data.sh; mounted read-only; checked against its SHA256SUMS.
# TWIN_DATA_DIR=./data

# Optional. Session cookie name, used by the API and baked into the web image at build time.
# Recommended in production: __Host-twin_session (HTTPS only, this host only).
# TWIN_COOKIE_NAME=__Host-twin_session

# Optional. Log level (DEBUG also shows health-check requests).
# TWIN_LOG_LEVEL=INFO

# Optional. Host ports Caddy listens on (keep 80/443 for automatic HTTPS with a real domain).
# TWIN_HTTP_PORT=80
# TWIN_HTTPS_PORT=443

# Optional Google sign-in: all three, or none. Redirect URI must be
# https://<TWIN_PUBLIC_HOST>/api/v1/auth/google/callback, registered in Google Cloud Console.
TWIN_GOOGLE_CLIENT_ID=
TWIN_GOOGLE_CLIENT_SECRET=
TWIN_GOOGLE_REDIRECT_URI=
# TWIN_GOOGLE_HOSTED_DOMAIN=
