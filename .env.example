# Copy to .env (gitignored) and choose your own password. Nothing here is a real secret.
POSTGRES_USER=twin
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=twin

# SQLAlchemy URL used by the API, the CLI and Alembic
TWIN_DATABASE_URL=postgresql+psycopg://twin:choose-a-local-password@127.0.0.1:5432/twin
# Server the tests may CREATE/DROP throwaway databases on (unset = database tests are skipped)
TWIN_TEST_DATABASE_URL=postgresql+psycopg://twin:choose-a-local-password@127.0.0.1:5432/postgres

TWIN_ENVIRONMENT=development
# Session cookies are Secure by default; plain http://127.0.0.1 development needs false
TWIN_COOKIE_SECURE=false

# Google sign-in (optional; ADR-019). Leave empty to offer password sign-in only.
# Create an OAuth client (type "Web application") in Google Cloud Console and register this exact
# redirect URI. The secret stays in .env (gitignored) and on the server; it never reaches the browser.
# Google accounts can sign in only after an admin links them:  twin-api link-google USERNAME EMAIL
TWIN_GOOGLE_CLIENT_ID=
TWIN_GOOGLE_CLIENT_SECRET=
TWIN_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Optional: accept only accounts of one Google Workspace domain
TWIN_GOOGLE_HOSTED_DOMAIN=
