# Copy to .env (gitignored) and fill in. Nothing here is a real secret; never commit a real .env.
# REQUIRED = the API or database will not start without it. Everything else has a safe default.
# Production rules (TWIN_ENVIRONMENT=production) are enforced at startup; see docs/security.md.

# ------------------------------------------------------------------ PostgreSQL (docker compose)
# REQUIRED. Choose your own password locally; generate a long random one for any server.
POSTGRES_USER=twin
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=twin

# ------------------------------------------------------------------ API (FastAPI, prefix TWIN_)
# REQUIRED. SQLAlchemy URL used by the API, the CLI and Alembic (a secret: it holds the password).
TWIN_DATABASE_URL=postgresql+psycopg://twin:choose-a-local-password@127.0.0.1:5432/twin
# Optional. Server the tests may CREATE/DROP throwaway databases on (unset = database tests skipped).
TWIN_TEST_DATABASE_URL=postgresql+psycopg://twin:choose-a-local-password@127.0.0.1:5432/postgres

# development | test | production. Production refuses unsafe settings and turns off /docs and
# /openapi.json.
TWIN_ENVIRONMENT=development
# Session cookies are Secure by default. Plain http://127.0.0.1 development needs false;
# production requires true (HTTPS only).
TWIN_COOKIE_SECURE=false
# Host names the API answers for, comma-separated. REQUIRED in production: the public host name
# plus any internal names health checks use (e.g. twin.example.org,api,localhost). Unset in
# development means any host.
TWIN_TRUSTED_HOSTS=

# Optional tuning (defaults shown)
# TWIN_COOKIE_NAME=twin_session        # production suggestion: __Host-twin_session (build the web
#                                      # app with the same TWIN_COOKIE_NAME)
# TWIN_SESSION_TTL_MINUTES=480         # 5..1440
# TWIN_MAX_FAILED_LOGINS=5             # then the account is locked for TWIN_LOCKOUT_MINUTES
# TWIN_LOCKOUT_MINUTES=15
# TWIN_REPO_ROOT=/app                  # where data/configs and data/reports are read from
# TWIN_MODELS_DIR=/app/models          # where registered model bundles are found by file name

# ------------------------------------------------------------------ Google sign-in (optional, ADR-019)
# Leave all three empty to offer password sign-in only. Set all three or none (production refuses a
# partial setup); in production the redirect URI must be https. Register exactly this redirect URI in
# Google Cloud Console (OAuth client type "Web application"). The secret stays on the server.
# Google accounts can sign in only after an admin links them:  twin-api link-google USERNAME EMAIL
TWIN_GOOGLE_CLIENT_ID=
TWIN_GOOGLE_CLIENT_SECRET=
TWIN_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Optional: accept only accounts of one Google Workspace domain
TWIN_GOOGLE_HOSTED_DOMAIN=

# ------------------------------------------------------------------ Web app (Next.js, read at BUILD time)
# Where the Next.js server proxies /api/v1 when it is not behind Caddy (local development).
# TWIN_API_ORIGIN=http://127.0.0.1:8000
# Must equal the API's TWIN_COOKIE_NAME (the web middleware only checks the cookie is present).
# TWIN_COOKIE_NAME=twin_session

# ------------------------------------------------------------------ End-to-end tests (local only)
# Put these in web/.env.e2e.local (gitignored), never here.
# E2E_USER=
# E2E_PASSWORD=
